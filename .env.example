# Copy to .env (never commit .env).
MSSQL_SA_PASSWORD=ChangeMe!Str0ngPassw0rd
# At least 32 random bytes, e.g.: openssl rand -base64 48
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
# dotnet run --project BotManager.Backend.API -- --hash-password "<password>"
# Keep the single quotes: the BCrypt hash contains '$', which compose would otherwise interpolate.
ADMIN_PASSWORD_HASH='$2a$12$replace-with-generated-hash'

GOOGLE_CLIENT_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# false only for plain http://localhost; keep true behind https.
AUTH_COOKIE_SECURE=false
# Optional PFX used to encrypt the Data Protection key ring (mount it into the api container).
DATA_PROTECTION_CERT_PATH=
DATA_PROTECTION_CERT_PASSWORD=

# --- Alerts when a bot goes down (all optional) ---
# Discord channel webhook (Channel settings -> Integrations -> Webhooks). Keep it secret.
ALERT_DISCORD_WEBHOOK_URL=
# At most one down alert per bot within this many minutes.
ALERT_DEBOUNCE_MINUTES=10
# SMTP e-mail (STARTTLS; implicit TLS on port 465 is not supported). ALERT_SMTP_TO may list several addresses (comma-separated).
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_SMTP_TO=
ALERT_SMTP_USE_SSL=true

# --- Metrics / OpenTelemetry ---
# Prometheus endpoint /metrics on the api container (internal network only; nginx never exposes it).
METRICS_ENABLED=true
# Optional: require "Authorization: Bearer <key>" for /metrics (also update deploy/prometheus/prometheus.yml).
METRICS_API_KEY=
# Optional OTLP collector for traces and metrics (e.g. http://otel-collector:4317); OTLP_PROTOCOL grpc or http/protobuf.
OTLP_ENDPOINT=
OTLP_PROTOCOL=grpc
# Monitoring profile (docker compose --profile monitoring up -d): Grafana on http://127.0.0.1:3000.
# Set a strong GRAFANA_ADMIN_PASSWORD (it falls back to "admin" when empty).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=15d

# --- HTTPS (docker-compose.https.yml: Caddy with automatic Let's Encrypt certificates) ---
# docker compose -f docker-compose.yml -f docker-compose.https.yml up -d --build
# To make that the default for plain `docker compose ...`, uncomment:
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# Public host name (DNS must point to this server; ports 80 and 443 must be reachable).
DOMAIN=
# Contact e-mail for the Let's Encrypt account (expiry notices).
ACME_EMAIL=
