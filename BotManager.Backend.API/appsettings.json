{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=BotManagerDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "BotManager",
    "Audience": "BotManager",
    "ExpiryMinutes": 15
  },
  "AdminCredentials": {
    "Email": "",
    "PasswordHash": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Auth": {
    "RefreshTokenDays": 14,
    "CookieSecure": true
  },
  "Recaptcha": {
    "SiteKey": "",
    "SecretKey": "",
    "RequiredAfterFailedAttempts": 3
  },
  "Bots": {
    "AutoStartEnabled": true
  },
  "Alerts": {
    "DiscordWebhookUrl": "",
    "DebounceMinutes": 10,
    "NotifyRecovery": true,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "User": "",
      "Password": "",
      "From": "",
      "To": "",
      "UseSsl": true
    }
  },
  "Metrics": {
    "Enabled": false,
    "ApiKey": ""
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "",
    "OtlpProtocol": "grpc",
    "ServiceName": "botmanager-api"
  },
  "LogRetention": {
    "SystemLogsDays": 30,
    "CommandUsageDays": 90,
    "LoginAuditDays": 90
  },
  "GoogleAuth": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
